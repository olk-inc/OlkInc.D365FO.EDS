<?xml version="1.0" encoding="utf-8"?>
<!--
  Only used for an F&O version the fscps.tools community storage does not have (normally none):
  Microsoft X++ build packages downloaded from LCS > Shared asset library > NuGet package
  and pushed to the feed in the D365_NUGET_FEED_URL secret. See docs/build-and-release.md.

  Set every version to the one you uploaded. From 10.0.38 or so the Application package is split into
  Application1 and Application2; list exactly the packages that came from LCS.
  Build-EDS.ps1 adds the ref\net40 folder of every package here to the compiler references.
-->
<packages>
  <package id="Microsoft.Dynamics.AX.Platform.CompilerPackage" version="SET-ME" />
  <package id="Microsoft.Dynamics.AX.Platform.DevALM.BuildXpp" version="SET-ME" />
  <package id="Microsoft.Dynamics.AX.Application1.DevALM.BuildXpp" version="SET-ME" />
  <package id="Microsoft.Dynamics.AX.Application2.DevALM.BuildXpp" version="SET-ME" />
  <!-- Needed only for the test model, which depends on ApplicationSuite. -->
  <package id="Microsoft.Dynamics.AX.ApplicationSuite.DevALM.BuildXpp" version="SET-ME" />
</packages>

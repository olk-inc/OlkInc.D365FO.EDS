public class OLK_EnvironmentDataSetupCode extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static OLK_EnvironmentDataSetupCode find(
        OLK_EdsEnvironmentId    _environmentId,
        OLK_EdsDataAreaId       _dataAreaId,
        OLK_EdsClassId          _classId,
        OLK_EdsMethodName       _methodName,
        boolean                 _forUpdate = false)
    {
        OLK_EnvironmentDataSetupCode code;

        code.selectForUpdate(_forUpdate);

        select firstonly code
            where code.EnvironmentId == _environmentId
               && code.RefDataAreaId == _dataAreaId
               && code.ClassId       == _classId
               && code.MethodName    == _methodName;

        return code;
    }

]]></Source>
			</Method>
			<Method>
				<Name>className</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    public display ClassName className()
    {
        return classId2Name(this.ClassId);
    }

]]></Source>
			</Method>
			<Method>
				<Name>createCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// Creates an inactive code job unless it already exists.
    /// </summary>
    public static void createCode(
        OLK_EdsEnvironmentId    _environmentId,
        OLK_EdsDataAreaId       _dataAreaId,
        OLK_EdsClassId          _classId,
        OLK_EdsMethodName       _methodName,
        FreeTxt                 _description)
    {
        OLK_EnvironmentDataSetupCode code;

        if (OLK_EnvironmentDataSetupCode::find(_environmentId, _dataAreaId, _classId, _methodName).RecId)
        {
            return;
        }

        code.EnvironmentId  = _environmentId;
        code.RefDataAreaId  = _dataAreaId;
        code.ClassId        = _classId;
        code.MethodName     = _methodName;
        code.Description    = _description;
        code.Active         = NoYes::No;
        code.insert();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (ret && !OLK_EnvironmentDataSetupExecuteCode::isCodeJobMethod(this.ClassId, this.MethodName))
        {
            ret = checkFailed(strFmt("@OLK_EDSLabel:NotACodeJob", this.MethodName, classId2Name(this.ClassId)));
        }

        return ret;
    }

]]></Source>
			</Method>

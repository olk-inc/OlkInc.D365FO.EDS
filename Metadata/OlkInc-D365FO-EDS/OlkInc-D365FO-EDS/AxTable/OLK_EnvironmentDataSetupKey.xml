	<Name>OLK_EnvironmentDataSetupKey</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// The key of the current environment before the master holds it. One record per host name.
/// </summary>
/// <remarks>
/// The private key is stored locked with the platform encryption of this environment. A database refresh replaces this table;
/// by then the master holds the key in the environment record, which arrives with the refresh.
/// </remarks>
public class OLK_EnvironmentDataSetupKey extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the key of a host name.
    /// </summary>
    public static OLK_EnvironmentDataSetupKey find(OLK_EdsHostName _hostName, boolean _forUpdate = false)
    {
        OLK_EnvironmentDataSetupKey localKey;

        if (_hostName)
        {
            localKey.selectForUpdate(_forUpdate);

            select firstonly localKey
                where localKey.HostName == _hostName;
        }

        return localKey;
    }

]]></Source>
			</Method>
		</Methods>

		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static OLK_EnvironmentDataSetupDefaultValues find(OLK_EdsDefaultValueId _id, boolean _forUpdate = false)
    {
        OLK_EnvironmentDataSetupDefaultValues defaultValue;

        if (_id)
        {
            defaultValue.selectForUpdate(_forUpdate);

            select firstonly defaultValue
                where defaultValue.Id == _id;
        }

        return defaultValue;
    }

]]></Source>
			</Method>
			<Method>
				<Name>valueList</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the comma separated value of a default value as a list of trimmed strings.
    /// </summary>
    /// <param name = "_id">The default value id.</param>
    /// <returns>A list of strings; empty when the default value is missing or blank.</returns>
    public static List valueList(OLK_EdsDefaultValueId _id)
    {
        List            result = new List(Types::String);
        ListEnumerator  enumerator = strSplit(OLK_EnvironmentDataSetupDefaultValues::find(_id).Value, ',').getEnumerator();

        while (enumerator.moveNext())
        {
            str item = strLTrim(strRTrim(enumerator.current()));

            if (item)
            {
                result.addEnd(item);
            }
        }

        return result;
    }

]]></Source>
			</Method>

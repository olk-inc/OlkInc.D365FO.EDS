		<Methods>
			<Method>
				<Name>isAllowedStatement</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks that a statement is a single UPDATE, INSERT or DELETE statement.
    /// </summary>
    /// <param name = "_statement">The statement.</param>
    /// <returns>true if the statement may be executed.</returns>
    public static boolean isAllowedStatement(str _statement)
    {
        str statement = strLTrim(strRTrim(_statement));
        str firstWord;
        int semicolon;
        int wordEnd;

        // A single trailing semicolon is accepted; anything after it would be a second statement.
        semicolon = strScan(statement, ';', 1, strLen(statement));
        if (semicolon && semicolon < strLen(statement))
        {
            return false;
        }

        wordEnd   = strFind(statement, ' \t\r\n', 1, strLen(statement));
        firstWord = strLwr(wordEnd ? subStr(statement, 1, wordEnd - 1) : statement);

        return firstWord == 'update' || firstWord == 'insert' || firstWord == 'delete';
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (ret && this.SQL && !OLK_EnvironmentDataSetupSQL::isAllowedStatement(this.SQL))
        {
            ret = checkFailed("@OLK_EDSLabel:SqlNotAllowed");
        }

        return ret;
    }

]]></Source>

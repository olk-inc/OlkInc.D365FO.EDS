				<Source><![CDATA[
    /// <summary>
    /// The environment the form is opened for, or the environment of the selected code job.
    /// </summary>
    private OLK_EdsEnvironmentId environmentId()
    {
        if (element.args() && element.args().record() && element.args().record().TableId == tableNum(OLK_EnvironmentDataSetupTable))
        {
            OLK_EnvironmentDataSetupTable environment = element.args().record();
            return environment.EnvironmentId;
        }

        return OLK_EnvironmentDataSetupCode.EnvironmentId;
    }

]]></Source>

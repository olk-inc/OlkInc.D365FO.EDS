			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Code jobs: methods of code job classes that run in a company when the environment data setup is executed.
/// </summary>
/// <remarks>
/// Create code jobs asks for the environment and company and adds an inactive code job for every code job method.
/// Activate all, Deactivate all and Delete all work on the code jobs shown in the list, so filter the list first.
/// </remarks>
[Form]
public class OLK_EnvironmentDataSetupCode extends FormRun
{
}

]]></Source>
			</Method>
			<Method>
				<Name>environmentId</Name>
				<Source><![CDATA[
    /// <summary>
    /// The environment the form is opened for, or else the environment of the selected code job, or else the master environment.
    /// </summary>
    private OLK_EdsEnvironmentId environmentId()
    {
        if (element.args() && element.args().record() && element.args().record().TableId == tableNum(OLK_EnvironmentDataSetupTable))
        {
            OLK_EnvironmentDataSetupTable environment = element.args().record();
            return environment.EnvironmentId;
        }

        if (OLK_EnvironmentDataSetupCode.EnvironmentId)
        {
            return OLK_EnvironmentDataSetupCode.EnvironmentId;
        }

        return OLK_EnvironmentDataSetupTable::findMaster().EnvironmentId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createCodeJobs</Name>
				<Source><![CDATA[
    /// <summary>
    /// Asks for the environment and company, then creates the missing code jobs for them.
    /// </summary>
    private void createCodeJobs()
    {
        Dialog      dialog = new Dialog("@OLK_EDSLabel:CreateCodeJobs");
        DialogField environmentField;
        DialogField companyField;
        int         created;

        environmentField = dialog.addFieldValue(extendedTypeStr(OLK_EdsEnvironmentId), element.environmentId());
        companyField     = dialog.addFieldValue(extendedTypeStr(OLK_EdsDataAreaId), curExt());

        if (dialog.run())
        {
            created = OLK_EnvironmentDataSetupExecuteCode::createCodeJobs(environmentField.value(), companyField.value() ? companyField.value() : curExt());
            info(strFmt("@OLK_EDSLabel:CodeJobsCreated", created, environmentField.value()));

            OLK_EnvironmentDataSetupCode_ds.research();
        }
    }

]]></Source>
			</Method>

        public void clicked()
        {
            super();

            if (Box::yesNo("@OLK_EDSLabel:DeleteAllConfirm", DialogButton::No) == DialogButton::Yes)
            {
                OLK_EnvironmentDataSetupCode::deleteForQuery(OLK_EnvironmentDataSetupCode_ds.queryRun().query());
                OLK_EnvironmentDataSetupCode_ds.research();
            }
        }

]]></Source>

						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            OLK_EdsEnvironmentId environmentId = element.environmentId();

            super();

            if (!environmentId)
            {
                throw error("@OLK_EDSLabel:EnvironmentIdEmpty");
            }

            OLK_EnvironmentDataSetupExecuteCode::createCodeJobs(environmentId, curExt());
            OLK_EnvironmentDataSetupCode_ds.research();
        }

